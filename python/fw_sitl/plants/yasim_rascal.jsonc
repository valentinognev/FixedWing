{
  // Table id; must match KNOWN_PLANT_IDS / load_plant_gains("yasim_rascal").
  "plant_id": "yasim_rascal",

  // Attitude PID P; lower than JSBSim (slower YASim FDM).
  "pid_kp": 0.65,
  // Attitude PID integral gain.
  "pid_ki": 0.10,
  // Attitude PID D; higher than JSBSim for the slower FDM.
  "pid_kd": 0.06,

  // Path/LOS bank: heading-error P (rad roll / rad heading); 1.2 vs JSBSim 1.0.
  "bank_kp_heading": 1.2,
  // Path bank: cross-track P (rad roll / m).
  "bank_kp_cross_track": 0.003,
  // Path: extra lookahead mixed into cross-track (m).
  "bank_xt_lookahead_m": 180.0,
  // Max commanded roll (rad); 0.40 so YASim does not sat-hunt.
  "bank_max_roll_rad": 0.40,
  // Path/LOS: altitude-error mix into pitch (rad / m).
  "bank_kp_alt": 0.028,
  // Legacy path pitch clamp used by path_kwargs (rad).
  "bank_max_pitch_rad": 0.12,
  // Attitude path-hold max pitch (rad).
  "att_max_pitch_rad": 0.35,
  // LOS / geometric chase max pitch (rad); dive when HSV drops inside 120 m.
  "att_los_max_pitch_rad": 0.70,

  // Nominal thrust fraction at cruise (also FW_THR_TRIM on this plant).
  "cruise_thrust": 0.68,
  // Extra thrust per metre of altitude error (1/m); energy on final.
  "climb_thrust_per_m": 0.025,
  // Thrust fraction floor; 0.18 so YASim can slow on approach.
  "min_thrust": 0.18,
  // Thrust fraction ceiling.
  "max_thrust": 1.0,

  // Cruise airspeed command (m/s); FW_AIRSPD_TRIM matches.
  "speed_mps": 28.0,
  // Final-approach airspeed (m/s) inside slow_range_m.
  "approach_speed_mps": 20.0,
  // Range (m) at which speed blends cruise → approach; 280 m for energy flare.
  "slow_range_m": 280.0,
  // Thrust P vs speed error (1 / (m/s)).
  "speed_thrust_per_mps": 0.06,
  // Locked-line / intercept lookahead (m).
  "lookahead_m": 500.0,

  // PX4 FW_AIRSPD_MIN (m/s); YASim floor is 5.
  "fw_airspd_min": 5.0,
  // PX4 FW_AIRSPD_TRIM (m/s).
  "fw_airspd_trim": 28.0,
  // PX4 FW_AIRSPD_MAX (m/s).
  "fw_airspd_max": 50.0,

  // HSV look-at altitude mix (rad/m); equals bank_kp_alt.
  "visual_lock_kp_alt": 0.028,

  /* PX4 FW_* overlay besides airspeed. Less P, more I than JSBSim; RR_P/FF from live YASim. */
  "px4_inner": [
    ["FW_PR_FF", 0.35], /* pitch-rate feedforward */
    ["FW_PR_I", 0.08], /* pitch-rate I */
    ["FW_PR_P", 0.04], /* pitch-rate P */
    ["FW_R_TC", 0.50], /* roll time constant (s) */
    ["FW_RR_FF", 0.48], /* roll-rate feedforward */
    ["FW_RR_I", 0.18], /* roll-rate I */
    ["FW_RR_P", 0.14], /* roll-rate P */
    ["FW_THR_TRIM", 0.68] /* throttle trim (matches cruise_thrust) */
  ],

  // Vehicle mass (kg); same Rascal airframe as JSBSim.
  "mass_kg": 13.0,
  // Wing reference area S (m²) in D = ½ ρ V² S C_D.
  "wing_area_m2": 1.0,
  // Parasite drag C_D0 (dimensionless).
  "cd0": 0.05,
  // Induced-drag factor k_ind in C_D ≈ C_D0 + k_ind C_L².
  "k_induced": 0.08,
  // C_Lα per radian; used when |α| ≥ alpha_small_rad.
  "cl_alpha": 5.0,
  // Air density ρ (kg/m³) for dynamic pressure; sea-level seed.
  "rho_kg_m3": 1.225,
  // Max thrust T_max (N); slightly higher than JSBSim seed.
  "t_max_n": 45.0,
  // Stall speed (m/s); governor floors/recovers from multiples of this.
  "v_stall_mps": 10.0,
  // Pure-pursuit gain k in a_des = k (û − v̂).
  "pp_gain": 2.0,
  // Target thrust fraction when T saturates (default 0.8 T_max).
  "thrust_target_frac": 0.8,
  // Forbidden-speed band: recover if V < v_min_mult × V_stall.
  "v_min_mult": 1.1,
  // Recover / thrust-limit floor: v_recover_mult × V_stall.
  "v_recover_mult": 1.2,
  // Speed-up rate (m/s²) toward cruise when T < thrust_target_frac T_max.
  "v_up_mps_s": 0.5,
  // Accel→attitude translator: "polar" (default) or "geometric".
  "attitude_from_accel": "polar",
  // Small-α threshold (rad, ~5°); below this, cos α ≈ 1 and C_D small-α polar.
  "alpha_small_rad": 0.087
}
