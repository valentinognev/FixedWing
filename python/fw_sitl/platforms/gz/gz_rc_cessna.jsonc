{
  // Table id; must match KNOWN_PLANT_IDS / load_plant_gains("gz_rc_cessna").
  "plant_id": "gz_rc_cessna",

  // Locked-line / intercept lookahead (m); shared across controllers.
  "lookahead_m": 500.0,

  // PX4 FW_AIRSPD_MIN (m/s); shared across controllers.
  "fw_airspd_min": 8.0,

  // PX4 FW_AIRSPD_TRIM (m/s); shared across controllers.
  "fw_airspd_trim": 16.0,

  // PX4 FW_AIRSPD_MAX (m/s); shared across controllers.
  "fw_airspd_max": 25.0,

  /* PX4 FW_* overlay besides airspeed (airspeed comes from fw_airspd_*). */
  "px4_inner":
  [
    ["FW_PR_P", 0.9], /* FW_PR_P */
    ["FW_PR_FF", 0.2], /* FW_PR_FF */
    ["FW_PR_I", 0.5], /* FW_PR_I */
    ["FW_RR_FF", 0.5], /* FW_RR_FF */
    ["FW_RR_P", 0.4], /* FW_RR_P */
    ["FW_RR_I", 0.7], /* FW_RR_I */
    ["FW_R_RMAX", 56.15], /* FW_R_RMAX */
    ["FW_YR_FF", 0.3], /* FW_YR_FF */
    ["FW_YR_P", 1.3], /* FW_YR_P */
    ["FW_YR_I", 0.7], /* FW_YR_I */
    ["FW_PSP_OFF", 0.0], /* FW_PSP_OFF */
    ["FW_P_LIM_MIN", -15.0], /* FW_P_LIM_MIN */
    ["FW_P_LIM_MAX", 15.0], /* FW_P_LIM_MAX */
    ["FW_T_CLMB_MAX", 5.0], /* FW_T_CLMB_MAX */
    ["FW_T_SINK_MAX", 3.5], /* FW_T_SINK_MAX */
    ["FW_T_SINK_MIN", 3.0], /* FW_T_SINK_MIN */
    ["FW_THR_TRIM", 0.55] /* FW_THR_TRIM */
  ],

  /* Per-controller outer-loop gains. Top-level holds shared airspeed/lookahead/px4. */
  "controllers": {
    // Pre-PP LOS chase (race_quat); omits PP-only aero/governor fields.
    "race_quat": {
      // Attitude PID (quaternion error → body rates) P gain.
      "pid_kp": 1.0,

      // Attitude PID integral gain.
      "pid_ki": 0.1,

      // Attitude PID derivative gain.
      "pid_kd": 0.03,

      // Stage-2 (Px4FwAttCascade) roll time constant (s). Neither in px4_inner → PX4 default.
      "roll_tc": 0.4,

      // Stage-2 pitch time constant (s). Neither in px4_inner → PX4 default.
      "pitch_tc": 0.4,

      // Path/LOS bank: heading-error P (rad roll / rad heading).
      "bank_kp_heading": 1.4,

      // Path bank: cross-track P (rad roll / m).
      "bank_kp_cross_track": 0.003,

      // Path: extra lookahead mixed into cross-track (m).
      "bank_xt_lookahead_m": 150.0,

      // Max commanded roll (rad).
      "bank_max_roll_rad": 0.55,

      // Path/LOS: altitude-error mix into pitch (rad / m).
      "bank_kp_alt": 0.03,

      // Legacy path pitch clamp used by path_kwargs (rad).
      "bank_max_pitch_rad": 0.12,

      // Attitude path-hold max pitch (rad).
      "att_max_pitch_rad": 0.26,

      // LOS / geometric chase max pitch (rad). Cessna stalls at 40° (live 135412).
      "att_los_max_pitch_rad": 0.26,

      // Nominal thrust fraction at cruise.
      "cruise_thrust": 0.80,

      // Extra thrust per metre of altitude error (1/m).
      "climb_thrust_per_m": 0.018,

      // Thrust fraction floor.
      "min_thrust": 0.50,

      // Thrust fraction ceiling.
      "max_thrust": 1.0,

      // Cruise airspeed command (m/s).
      "speed_mps": 16.0,

      // Final-approach airspeed (m/s) inside slow_range_m.
      "approach_speed_mps": 12.0,

      // Range (m) at which speed blends cruise → approach.
      "slow_range_m": 180.0,

      // Thrust P vs speed error (1 / (m/s)).
      "speed_thrust_per_mps": 0.07
    },
    // LOS Euler-error close (race_euler); outer gains copied from race_quat; omits PP-only aero/governor fields.
    "race_euler": {
      // Attitude PID (quaternion error → body rates) P gain.
      "pid_kp": 1.0,

      // Attitude PID integral gain.
      "pid_ki": 0.1,

      // Attitude PID derivative gain.
      "pid_kd": 0.03,

      // Stage-2 (Px4FwAttCascade) roll time constant (s). Neither in px4_inner → PX4 default.
      "roll_tc": 0.4,

      // Stage-2 pitch time constant (s). Neither in px4_inner → PX4 default.
      "pitch_tc": 0.4,

      // Path/LOS bank: heading-error P (rad roll / rad heading).
      "bank_kp_heading": 1.4,

      // Path bank: cross-track P (rad roll / m).
      "bank_kp_cross_track": 0.003,

      // Path: extra lookahead mixed into cross-track (m).
      "bank_xt_lookahead_m": 150.0,

      // Max commanded roll (rad).
      "bank_max_roll_rad": 0.55,

      // Path/LOS: altitude-error mix into pitch (rad / m).
      "bank_kp_alt": 0.03,

      // Legacy path pitch clamp used by path_kwargs (rad).
      "bank_max_pitch_rad": 0.12,

      // Attitude path-hold max pitch (rad).
      "att_max_pitch_rad": 0.26,

      // LOS / geometric chase max pitch (rad). Cessna stalls at 40° (live 135412).
      "att_los_max_pitch_rad": 0.26,

      // Nominal thrust fraction at cruise.
      "cruise_thrust": 0.80,

      // Extra thrust per metre of altitude error (1/m).
      "climb_thrust_per_m": 0.018,

      // Thrust fraction floor.
      "min_thrust": 0.50,

      // Thrust fraction ceiling.
      "max_thrust": 1.0,

      // Cruise airspeed command (m/s).
      "speed_mps": 16.0,

      // Final-approach airspeed (m/s) inside slow_range_m.
      "approach_speed_mps": 12.0,

      // Range (m) at which speed blends cruise → approach.
      "slow_range_m": 180.0,

      // Thrust P vs speed error (1 / (m/s)).
      "speed_thrust_per_mps": 0.07
    },
    // Pure-pursuit a_des → attitude_from_accel → SpeedGovernor.
    "pure_pursuit_quat": {
      // Attitude PID (quaternion error → body rates) P gain.
      "pid_kp": 1.0,

      // Attitude PID integral gain.
      "pid_ki": 0.1,

      // Attitude PID derivative gain.
      "pid_kd": 0.03,

      // Stage-2 (Px4FwAttCascade) roll time constant (s). Neither in px4_inner → PX4 default.
      "roll_tc": 0.4,

      // Stage-2 pitch time constant (s). Neither in px4_inner → PX4 default.
      "pitch_tc": 0.4,

      // Path/LOS bank: heading-error P (rad roll / rad heading).
      "bank_kp_heading": 1.4,

      // Path bank: cross-track P (rad roll / m).
      "bank_kp_cross_track": 0.003,

      // Path: extra lookahead mixed into cross-track (m).
      "bank_xt_lookahead_m": 150.0,

      // Max commanded roll (rad).
      "bank_max_roll_rad": 0.55,

      // Path/LOS: altitude-error mix into pitch (rad / m).
      "bank_kp_alt": 0.03,

      // Legacy path pitch clamp used by path_kwargs (rad).
      "bank_max_pitch_rad": 0.12,

      // Attitude path-hold max pitch (rad).
      "att_max_pitch_rad": 0.26,

      // LOS / geometric chase max pitch (rad). Cessna stalls at 40° (live 135412).
      "att_los_max_pitch_rad": 0.26,

      // Nominal thrust fraction at cruise.
      "cruise_thrust": 0.80,

      // Extra thrust per metre of altitude error (1/m).
      "climb_thrust_per_m": 0.018,

      // Thrust fraction floor.
      "min_thrust": 0.50,

      // Thrust fraction ceiling.
      "max_thrust": 1.0,

      // Cruise airspeed command (m/s).
      "speed_mps": 16.0,

      // Final-approach airspeed (m/s) inside slow_range_m.
      "approach_speed_mps": 12.0,

      // Range (m) at which speed blends cruise → approach.
      "slow_range_m": 180.0,

      // Thrust P vs speed error (1 / (m/s)).
      "speed_thrust_per_mps": 0.07,

      // Vehicle mass (kg) for T = (m a_parallel + D + mg sin γ) / cos α.
      "mass_kg": 10.0,

      // Wing reference area S (m²) in D = ½ ρ V² S C_D.
      "wing_area_m2": 0.8,

      // Parasite drag C_D0 (dimensionless).
      "cd0": 0.06,

      // Induced-drag factor k_ind in C_D ≈ C_D0 + k_ind C_L².
      "k_induced": 0.08,

      // C_Lα per radian; used when |α| ≥ alpha_small_rad.
      "cl_alpha": 5.0,

      // Air density ρ (kg/m³) for dynamic pressure; sea-level seed.
      "rho_kg_m3": 1.225,

      // Max thrust T_max (N); PX4 fraction is T / t_max_n.
      "t_max_n": 30.0,

      // Stall speed (m/s); governor floors/recovers from multiples of this.
      "v_stall_mps": 8.0,

      // Pure-pursuit gain k in a_des = k (û − v̂).
      "pp_gain": 2.0,

      // Target thrust fraction when T saturates (default 0.8 T_max).
      "thrust_target_frac": 0.8,

      // Forbidden-speed band: recover if V < v_min_mult × V_stall.
      "v_min_mult": 1.1,

      // Recover / thrust-limit floor: v_recover_mult × V_stall.
      "v_recover_mult": 1.2,

      // Speed-up rate (m/s²) toward cruise when T < thrust_target_frac T_max.
      "v_up_mps_s": 0.5,

      // Accel→attitude translator: "polar" (default) or "geometric".
      "attitude_from_accel": "polar",

      // Small-α threshold (rad, ~5°); below this, cos α ≈ 1 and C_D small-α polar.
      "alpha_small_rad": 0.087
    }
  }
}

