{
  "zmq": {
    "image": "tcp://127.0.0.1:5555",
    "color": "tcp://127.0.0.1:5556",
    "track": "tcp://127.0.0.1:5557"
  },
  "balloons": [
    {"ned": [300, 0, 0], "color": [255, 0, 0], "diameter_m": 10},
    {"ned": [600, 80, 15], "color": [0, 255, 0], "diameter_m": 10},
    {"ned": [900, 40, -15], "color": [0, 0, 255], "diameter_m": 10}
  ],
  "spawn": {
    "ned": [0, 0, 0],
    "heading_deg": 0
  },
  // Race launcher plant + length (CLI flags override)
  "sim": {
    // jsbsim (headless default) | viz | yasim | gz
    "platform": "yasim",
    // only used when platform=gz (or CLI --gz): rc_cessna | advanced_plane
    "gz_model": "rc_cessna",
    // 0 = no time limit; >0 = stop after that many seconds (CLI --duration overrides)
    "duration_s": 75
  },
  "camera": {
    "hfov_deg": 90, "vfov_deg": 70,
    // Seeker mount vs body +X (future gimbal). +azimuth = right, +elevation = up.
    "azimuth_deg": 0, "elevation_deg": 0,
    "width_px": 640, "height_px": 480,
    "rate_hz": 10,
    "fg_window_pattern": "FlightGear|fgfs"
  },
  "render_rate_hz": 20,
  "guidance": {
    "control_rate_hz": 20,
    "speed_mps": 30,
    "pass_radius_m": 50,
    "lookahead_m": 500,
    "assisted_print_period_s": 5,
    "stale_track_warn_s": 10,
    // 0 = keep cycling balloons until sim.duration_s (or Ctrl+C); N>0 = end after N full circuits
    "laps": 1,
    // velocity = locked-line TECS path setpoints; attitude = px4_att_cascade + attitude_format (Euler/quat SET_ATTITUDE_TARGET); rates = body rates from Euler φ̇θ̇ψ̇ (implemented)
    "cmd_mode": "velocity",
    // used when cmd_mode=attitude: quat = raw quaternion, euler = Euler packed as quat
    "attitude_format": "euler",
    // pure_pursuit_quat = PP a_des→attitude→governor (default); race_quat = pre-PP LOS q_des_from_los chase; race_euler = same LOS chase closing Euler φ/θ error
    // (race_euler vs race_quat only differ under cmd_mode=attitude; cmd_mode=rates sends the same body rates for both)
    "controller": "pure_pursuit_quat",
    "alt_preserve_heading_err_deg": 20
  },
  "verification": {
    "pixel_rms_max_px": 15,
    "pass_time_tol_s": 5,
    "path_rms_max_m": 30
  }
}
